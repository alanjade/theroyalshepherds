# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client / NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for metadata, sitemap, canonical URLs, emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com) — used for application/registration emails.
# Leave EMAIL_PROVIDER_API_KEY unset to no-op (emails are skipped, logged to console).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS="The Royal Shepherds <no-reply@yourdomain.org>"

# Company timezone default (can also be overridden in site_settings)
NEXT_PUBLIC_DEFAULT_TIMEZONE=Africa/Lagos
